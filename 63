class Solution {
    public int uniquePathsWithObstacles(int[][] grid) {
        // 1. Handle edge case: if start or end has an obstacle, no path is possible.
        if (grid == null || grid[0][0] == 1 || grid[grid.length - 1][grid[0].length - 1] == 1) {
            return 0;
        }

        int m = grid.length;
        int n = grid[0].length;
        
        // 2. Use a 1D array to track unique path counts for the current row.
        int[] dp = new int[n];
        dp[0] = 1;

        // 3. Update the path counts cell by cell, row by row.
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == 1) {
                    dp[j] = 0;
                } else if (j > 0) {
                    dp[j] += dp[j - 1];
                }
            }
        }

        return dp[n - 1];
    }
}
