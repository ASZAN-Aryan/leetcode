import java.util.*;

class Solution {
    public List<Integer> distanceK(TreeNode root, TreeNode target, int k) {
        List<Integer> ans = new ArrayList<>();
        if (root == null || target == null) return ans;

        // Har node ke parent ka map banaya
        Map<TreeNode, TreeNode> parentKaMap = new HashMap<>();
        findParents(root, null, parentKaMap);

        Queue<TreeNode> q = new LinkedList<>();
        Set<TreeNode> visited = new HashSet<>();

        // Target node se BFS shuru
        q.add(target);
        visited.add(target);
        
        int currentDistance = 0;

        while (!q.isEmpty()) {
            if (currentDistance == k) break; 
            
            int levelSize = q.size();
            for (int i = 0; i < levelSize; i++) {
                TreeNode currentNode = q.poll();

                // 1. Left child check karo
                if (currentNode.left != null && !visited.contains(currentNode.left)) {
                    visited.add(currentNode.left);
                    q.add(currentNode.left);
                }
                
                // 2. Right child check karo
                if (currentNode.right != null && !visited.contains(currentNode.right)) {
                    visited.add(currentNode.right);
                    q.add(currentNode.right);
                }
                
                // 3. Parent node check karo (Upar jaane ke liye)
                TreeNode uskaParent = parentKaMap.get(currentNode);
                if (uskaParent != null && !visited.contains(uskaParent)) {
                    visited.add(uskaParent);
                    q.add(uskaParent);
                }
            }
            currentDistance++;
        }

        // Bache hue saare nodes answer hain
        while (!q.isEmpty()) {
            ans.add(q.poll().val);
        }

        return ans;
    }

    private void findParents(TreeNode node, TreeNode parentNode, Map<TreeNode, TreeNode> parentKaMap) {
        if (node == null) return;
        if (parentNode != null) {
            parentKaMap.put(node, parentNode);
        }
        findParents(node.left, node, parentKaMap);
        findParents(node.right, node, parentKaMap);
    }
}
